{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell (venv)": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'"
      ]
    },
    "Command Prompt (venv)": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "args": ["/K", "${workspaceFolder}\\.venv\\Scripts\\activate.bat"]
    },
    "Git Bash (venv)": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": [
        "-c",
        "source '${workspaceFolder}/.venv/Scripts/activate'; exec bash -i"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt (venv)"
}
